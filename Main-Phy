    st.session_state.last_alert_sent = None
if 'last_price' not in st.session_state:
    st.session_state.last_price = None

# Function to send async telegram messages
def send_telegram_alert(signal_data):
    try:
        loop = asyncio.new_event_loop()
        asyncio.set_event_loop(loop)
        loop.run_until_complete(send_trading_signal(signal_data))
    except Exception as e:
        print(f"Telegram send error: {e}")

# Main update function
def update_dashboard():
    # Fetch data
    data = get_live_xauusd(period=period, interval=interval)
    
    if data.empty:
        st.error("⚠️ Failed to fetch data. Check your internet connection.")
        return
    
    # Get current price
    current_price = data['Close'].iloc[-1]
    prev_price = data['Close'].iloc[-2] if len(data) > 1 else current_price
    price_change = current_price - prev_price
    price_change_pct = (price_change / prev_price) * 100
    
    # Train AI if not trained and have enough data
    if not st.session_state.ai_trained and len(data) >= 100:
        with st.spinner("🤖 Training RaSoda AI on historical data..."):
            success = ra_soda_ai.train(data)
            if success:
                st.session_state.ai_trained = True
                st.success("✅ RaSoda AI is now active!")
                st.rerun()
    
    # Get AI prediction
    if st.session_state.ai_trained:
        ai_prediction = ra_soda_ai.predict(data)
    else:
        ai_prediction = {"signal": "LOADING...", "confidence": 0, "direction": "🤖 Training AI... Please wait"}
    
    # Get technical signal
    tech_signal = get_trading_signal(data)
    
    # Update price cards
    price_placeholder.metric(
        label="💰 XAUUSD Price",
        value=f"${current_price:.2f}",
        delta=f"{price_change_pct:.2f}%"
    )
    
    # Combined signal
    if tech_signal['action'] == "BUY 🟢" and "BUY" in ai_prediction['signal']:
        final_signal = "🚀 STRONG BUY"
    elif tech_signal['action'] == "SELL 🔴" and "SELL" in ai_prediction['signal']:
        final_signal = "⚠️ STRONG SELL"
    else:
        final_signal = tech_signal['action']
    
    signal_placeholder.metric(
        label="📊 Trading Signal",
        value=final_signal,
        delta=f"Strength: {tech_signal['strength']}"
    )
    
    confidence_placeholder.metric(
        label="🧠 AI Confidence",
        value=f"{ai_prediction['confidence']:.1f}%",
        delta=ai_prediction['direction']
    )
    
    # Send Telegram alerts for STRONG signals (only once per signal)
    if tech_signal['strength'] == 'STRONG' and st.session_state.ai_trained:
        alert_key = f"{tech_signal['action']}_{current_price:.0f}"
        if st.session_state.last_alert_sent != alert_key:
            signal_data = {
                'price': current_price,
                'action': tech_signal['action'],
                'confidence': ai_prediction.get('confidence', 0),
                'rsi': tech_signal.get('rsi', 50),
                'macd': tech_signal.get('macd', 0),
                'trend': tech_signal['action'],
                'ai_signal': ai_prediction.get('signal', 'N/A')
            }
            send_telegram_alert(signal_data)
            st.session_state.last_alert_sent = alert_key
            st.toast("📱 Telegram alert sent!", icon="✅")
    
    # Send price alert for big moves (>1%)
    if st.session_state.last_price is not None and st.session_state.ai_trained:
        big_move_pct = abs(((current_price - st.session_state.last_price) / st.session_state.last_price) * 100)
        if big_move_pct > 1.0:
            send_telegram_alert(signal_data)  # Reuse or create price alert
            st.toast("📱 Price alert sent to Telegram!", icon="📈")
    
    st.session_state.last_price = current_price
    
    # Create candlestick chart
    fig = make_subplots(
        rows=3, cols=1,
        shared_xaxes=True,
        vertical_spacing=0.05,
        row_heights=[0.6, 0.2, 0.2],
        subplot_titles=("XAUUSD Price with MAs", "RSI (14)", "MACD")
    )
    
    # Candlestick chart
    fig.add_trace(
        go.Candlestick(
            x=data.index,
            open=data['Open'],
            high=data['High'],
            low=data['Low'],
            close=data['Close'],
            name="XAUUSD"
        ),
        row=1, col=1
    )
    
    # Add moving averages
    indicators = calculate_technical_indicators(data)
    fig.add_trace(go.Scatter(x=data.index, y=indicators['SMA_20'], name="SMA 20", line=dict(color="orange", width=1)), row=1, col=1)
    fig.add_trace(go.Scatter(x=data.index, y=indicators['SMA_50'], name="SMA 50", line=dict(color="blue", width=1)), row=1, col=1)
    
    # RSI
    fig.add_trace(go.Scatter(x=data.index, y=indicators['RSI'], name="RSI", line=dict(color="purple")), row=2, col=1)
    fig.add_hline(y=70, line_dash="dash", line_color="red", row=2, col=1)
    fig.add_hline(y=30, line_dash="dash", line_color="green", row=2, col=1)
    
    # MACD
    fig.add_trace(go.Bar(x=data.index, y=indicators['MACD_Histogram'], name="MACD Histogram", marker_color="gray"), row=3, col=1)
    fig.add_trace(go.Scatter(x=data.index, y=indicators['MACD'], name="MACD", line=dict(color="blue")), row=3, col=1)
    fig.add_trace(go.Scatter(x=data.index, y=indicators['MACD_Signal'], name="Signal", line=dict(color="red")), row=3, col=1)
    
    fig.update_layout(
        title="📈 RaSoda Real-Time XAUUSD Analysis",
        xaxis_title="Time",
        height=800,
        template="plotly_dark"
    )
    
    fig.update_xaxes(rangeslider_visible=False)
    
    chart_placeholder.plotly_chart(fig, use_container_width=True)
    
    # Display technical signals
    with signals_placeholder.container():
        st.markdown("### 📊 Technical Indicators Summary")
        
        cols = st.columns(3)
        for i, (indicator, value, _) in enumerate(tech_signal['signals']):
            cols[i % 3].metric(
                label=indicator,
                value=value
            )
        
        col1, col2 = st.columns(2)
        with col1:
            st.metric("RSI Value", f"{tech_signal['rsi']:.1f}")
            st.metric("Signal Score", f"{tech_signal['score']:+d}")
        with col2:
            st.metric("MACD Value", f"{tech_signal['macd']:.4f}")
            st.metric("AI Status", "Trained ✅" if st.session_state.ai_trained else "Training...")

# Initial update
update_dashboard()

