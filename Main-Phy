st.markdown('<p style="text-align: center;">XAUUSD (Gold) | AI-Powered Real-Time Analysis</p>', unsafe_allow_html=True)

# Sidebar
with st.sidebar:
    st.header("⚙️ Settings")
    
    interval = st.selectbox(
        "Timeframe",
        ["1m", "5m", "15m", "30m", "1h"],
        index=1
    )
    
    period = st.selectbox(
        "Data Period",
        ["1d", "5d", "1mo", "3mo"],
