import asyncio
from telegram import Bot
from telegram.error import TelegramError
import logging

# Your credentials from BotFather
TELEGRAM_TOKEN = "YOUR_BOT_TOKEN_HERE"  # Paste your token!
TELEGRAM_CHAT_ID = "YOUR_CHAT_ID_HERE"  # Paste your chat ID!

# Set up logging
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

# Create bot instance
bot = Bot(token=TELEGRAM_TOKEN)

async def send_telegram_message(message: str):
    """Send message to your Telegram"""
    try:
        await bot.send_message(chat_id=TELEGRAM_CHAT_ID, text=message, parse_mode='HTML')
        print(f"✅ Message sent: {message[:50]}...")
    except TelegramError as e:
        print(f"❌ Failed to send: {e}")

async def send_trading_signal(signal_data: dict):
    """Send formatted trading signal"""
    message = f"""
🚨 <b>RaSoda Trading Signal</b> 🚨

📊 <b>Asset:</b> XAUUSD (Gold)
💰 <b>Price:</b> ${signal_data.get('price', 'N/A')}
🎯 <b>Signal:</b> {signal_data.get('action', 'HOLD')}
📈 <b>Confidence:</b> {signal_data.get('confidence', 0)}%

<b>Technical Indicators:</b>
• RSI: {signal_data.get('rsi', 'N/A')}
• MACD: {signal_data.get('macd', 'N/A')}
• Trend: {signal_data.get('trend', 'N/A')}

🤖 <b>AI Prediction:</b> {signal_data.get('ai_signal', 'N/A')}

⚠️ <i>Risk Management: Use stop-loss! Not financial advice.</i>
    """
    await send_telegram_message(message)

async def send_price_alert(price: float, change_pct: float):
    """Send price alert when gold moves significantly"""
    emoji = "🟢" if change_pct > 0 else "🔴"
    message = f"""
{emoji} <b>Price Alert - XAUUSD</b> {emoji}

💰 Current Price: <b>${price:.2f}</b>
📊 Change: <b>{change_pct:+.2f}%</b>

⏰ Time: {__import__('datetime').datetime.now().strftime('%H:%M:%S')}
    """
    await send_telegram_message(message)

# For testing
if __name__ == "__main__":
    async def test():
        await send_telegram_message("🤖 RaSoda Bot is ONLINE! Ready for trading signals.")
    
    asyncio.run(test())